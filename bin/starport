#!/usr/bin/env python3
import sys
import os
sys.dont_write_bytecode = True
from pathlib import Path
root = Path(__file__).resolve().parents[1]
python = root / 'server/.venv/bin/python'
if python.is_file() and (python.parent.parent / '.starport-ready').exists() and Path(sys.prefix) != python.parent.parent:
    os.execv(str(python), [str(python), str(Path(__file__).resolve()), *sys.argv[1:]])
if len(sys.argv) > 1 and sys.argv[1] == 'install':
    os.execv(sys.executable, [sys.executable, str(root / 'server/install.py'), *sys.argv[2:]])
sys.path.insert(0, str(root))
from isolation_toolkit.__main__ import main
main()
